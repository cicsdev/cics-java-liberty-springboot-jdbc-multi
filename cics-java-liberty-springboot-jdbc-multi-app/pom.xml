<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ibm.cicsdev.springboot</groupId>
    <artifactId>cics-java-liberty-springboot-jdbc-multi</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>cics-java-liberty-springboot-jdbc-multi-app</artifactId>
  <packaging>war</packaging>
  <name>CICS JDBC Multi DataSource Spring Boot - Application</name>

  <properties>
    <!-- Prevent spring-boot-maven-plugin repackaging the WAR as a fat bootWar.
         Without this, Liberty deployment fails as the WAR contains an embedded Tomcat. -->
    <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- CICS TS BOM — version sourced from parent <cics.bom.version> property -->
      <dependency>
        <groupId>com.ibm.cics</groupId>
        <artifactId>com.ibm.cics.ts.bom</artifactId>
        <version>${cics.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- Spring Boot web support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring JDBC Support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>

    <!-- Exclude only Tomcat embed jars — Liberty provides the servlet container -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <finalName>cics-java-liberty-springboot-jdbc-multi</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
